# ==============================================================================
# BUMBLEBEE ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE CONNECTION (PostgreSQL)
# Get a free database URL from Neon.tech, Supabase.com, or Render.com:
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/bumblebee?sslmode=require"

# 2. NEXTAUTH / AUTHENTICATION
NEXTAUTH_SECRET="bumblebee_super_secret_jwt_key_change_me_in_production"
NEXTAUTH_URL="http://localhost:3000"

# 3. BACKEND & WEBHOOK COMMUNICATION
BUMBLEBEE_API_URL="http://localhost:3000/api"
WORKER_SECRET_KEY="worker_internal_secret_key_change_me"

# 4. OPTIONAL AI & NOTIFICATION KEYS (Add when integrating external providers)
OPENAI_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
RESEND_API_KEY=""
